# Git LFS: modelos de origem enviados prontos (GLB do Meshy e outros, 20–30 MB cada) e projetos do
# Blender. O jogo não carrega esses arquivos (usa os convertidos em js/assets/), então o GitHub Pages
# e os testes do CI não precisam deles. (A rede do ambiente na nuvem precisa liberar lfs.github.com.)
assets/Criar_Personagem/**/exemplo_glb/*.glb filter=lfs diff=lfs merge=lfs -text
assets/fontes/** filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
# Fontes das criaturas (GLB do Meshy enviados): a retopologia no Blender parte deles
assets/Creatures/**/fonte/*.glb filter=lfs diff=lfs merge=lfs -text
# Saídas do lote de topologia inteligente (candidatas validadas peça a peça; o jogo não carrega)
assets/_retopo/**/*.glb filter=lfs diff=lfs merge=lfs -text
# Estruturas geradas no Meshy (comprimidas com Draco: tools/estruturas/comprimir_draco.mjs) e as
# versões reduzidas no Blender (o jogo usa as convertidas em js/assets/estruturas/)
assets/estruturas_ambiente/**/Meshy/*.glb filter=lfs diff=lfs merge=lfs -text
assets/models/estruturas/*.glb filter=lfs diff=lfs merge=lfs -text
# NPCs gerados no Meshy (comprimidos com Draco: tools/estruturas/comprimir_draco.mjs)
assets/npcs/**/*.glb filter=lfs diff=lfs merge=lfs -text
# Cabelos gerados no Meshy por texto, já separados da cabeça de manequim e reduzidos no Blender
# (tools/meshy/separar_cabelo.py); a fonte do Meshy fica fora do repositório (.cache_criacao)
assets/Criar_Personagem/Cabelo_Meshy/*.glb filter=lfs diff=lfs merge=lfs -text
# Barbas e bigodes gerados no Meshy, separados da cabeça de manequim (tools/meshy/separar_cabelo.py --tipo barba)
assets/personagens/barbas/**/*.glb filter=lfs diff=lfs merge=lfs -text
# Peitorais avulsos e corpos atléticos enviados (GLB/STL do Meshy; o jogo usa os convertidos)
assets/Criar_Personagem/Armaduras_Avulsas/*.glb filter=lfs diff=lfs merge=lfs -text
assets/Criar_Personagem/Corpos_Atleticos/*.glb filter=lfs diff=lfs merge=lfs -text
assets/Criar_Personagem/Corpos_Atleticos/*.stl filter=lfs diff=lfs merge=lfs -text
assets/cabelos/*.glb filter=lfs diff=lfs merge=lfs -text
assets/Creatures/Enemies/*.glb filter=lfs diff=lfs merge=lfs -text
assets/Criar_Personagem/*.glb filter=lfs diff=lfs merge=lfs -text
